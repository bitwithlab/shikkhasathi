# ShikkhaSathi backend — copy to backend/.env (read automatically by `./mvnw spring-boot:run` and by
# docker compose). Real environment variables override this file. Bootstrap values are env-only (CLAUDE.md §0B).
# Everything under "Integrations" is OPTIONAL here: set it in Admin → সেটিংস → Integrations instead
# (Admin value wins; env is the fallback; unset = disabled, Fake adapter outside production).

# development | test | production   (production refuses to start with dev secrets)
NODE_ENV=development
# dev (default) = seed demo data into empty databases · prod for deployments
SPRING_PROFILES_ACTIVE=dev
PORT=8080
# Public origin of the website (CORS, links in emails, payment return URLs). Vite dev server: 5173.
APP_URL=http://localhost:5173
# api = HTTP only · worker = job workers + schedules · all = both (default)
SS_ROLE=all
# Optional: URL of the website's index.html, used for server-rendered <head> on /c /u /s /t pages
WEBSITE_INDEX_URL=
LOG_LEVEL=INFO

# ---------- CORE database (Supabase project "ShikkhaSathi Core") ----------
# App: transaction pooler (port 6543 → prepareThreshold=0). Flyway migrations: direct (5432).
# Values below match the docker compose data services (core 5433, content 5434); a single local Postgres uses 5432.
CORE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/shikkhasathi_core
CORE_DIRECT_URL=postgres://postgres:postgres@localhost:5433/shikkhasathi_core
SUPABASE_CORE_URL=
SUPABASE_CORE_SERVICE_ROLE_KEY=

# ---------- CONTENT database (Supabase project "ShikkhaSathi Content") ----------
CONTENT_DATABASE_URL=postgres://postgres:postgres@localhost:5434/shikkhasathi_content
CONTENT_DIRECT_URL=postgres://postgres:postgres@localhost:5434/shikkhasathi_content
SUPABASE_CONTENT_URL=
SUPABASE_CONTENT_SERVICE_ROLE_KEY=
# true when the *_DATABASE_URL point at the Supabase pooler (also auto-detected from :6543)
DB_POOLER=false

# ---------- secrets & infra ----------
REDIS_URL=redis://localhost:6379
# 32 bytes as 64 hex chars:  openssl rand -hex 32
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ================= Integrations (env fallback; Admin panel overrides) =================
# Email — Brevo (app.brevo.com)
BREVO_API_KEY=
BREVO_SENDER_NAME=ShikkhaSathi
BREVO_SENDER_EMAIL=no-reply@shikkhasathi.com
BREVO_REPLY_TO=support@shikkhasathi.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Google OAuth + Classroom + Pub/Sub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Payments (sslcommerz | bkash | fake)
PAYMENT_GATEWAY=fake
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Video (bunny | fake)
VIDEO_PROVIDER=fake
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_KEY=
BUNNY_CDN_HOST=
VIDEO_WEBHOOK_SECRET=

# SMS (http | fake)
SMS_PROVIDER=fake
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Push
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Search (Meilisearch; unset = Postgres full-text fallback)
MEILI_HOST=
MEILI_MASTER_KEY=

# Business
COMMISSION_PERCENT=20
