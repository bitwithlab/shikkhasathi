<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted session is bound to this device's Keystore key: never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ss_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ss_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
