# Public reverse proxy. One origin serves the website (static) and the backend (/api/v1).
#   Production: SITE_ADDRESS="shikkhasathi.com, www.shikkhasathi.com" (automatic TLS).
#   docker compose (local): SITE_ADDRESS=":80", BACKEND=backend:8080, WEBSITE=website:80.
{$SITE_ADDRESS:shikkhasathi.com, www.shikkhasathi.com} {
	encode zstd gzip
	@www host www.shikkhasathi.com
	redir @www https://shikkhasathi.com{uri} permanent

	# API, payment callbacks/webhooks, live sitemap → Spring Boot.
	@api path /api/* /sitemap.xml
	handle @api {
		reverse_proxy {$BACKEND:backend:8080}
	}
	# Public detail pages get server-rendered <head> (title, meta, Open Graph, JSON-LD) from the backend,
	# which wraps the website's index.html (WEBSITE_INDEX_URL).
	@seo path_regexp seo ^/(c|u|s|t)/[a-z0-9-]{1,120}/?$
	handle @seo {
		reverse_proxy {$BACKEND:backend:8080}
	}
	handle {
		reverse_proxy {$WEBSITE:website:80}
	}
}

admin.shikkhasathi.com {
	redir / https://shikkhasathi.com/admin 302
	redir * https://shikkhasathi.com/admin{uri} 302
}

media.shikkhasathi.com {
	root * /srv/media
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}
