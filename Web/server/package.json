{
  "name": "@shikkhasathi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.core.config.ts && drizzle-kit generate --config drizzle.content.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seed/index.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts && tsx scripts/gen-endpoints.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@shikkhasathi/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.2",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
