{
  "name": "shikkhasathi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./Web/server --filter ./Web/client dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:openapi": "pnpm --filter @shikkhasathi/server gen:openapi",
    "db:migrate": "pnpm --filter @shikkhasathi/server db:migrate",
    "db:seed": "pnpm --filter @shikkhasathi/server db:seed",
    "check": "bash scripts/check-all.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "type": "module"
}
