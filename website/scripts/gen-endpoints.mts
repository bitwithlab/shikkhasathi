// Emits src/api/contracts/endpoints.gen.ts: a zod-free {method, path, auth} map with the same shape and
// (type-only) types as `contracts`, so the web client can call endpoints without bundling zod on every page.
import { writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { contracts } from '@/api';

const out = resolve(dirname(fileURLToPath(import.meta.url)), '../src/api/contracts/endpoints.gen.ts');
const map: Record<string, Record<string, { method: string; path: string; auth: string }>> = {};
for (const [g, eps] of Object.entries(contracts)) {
  map[g] = {};
  for (const [k, e] of Object.entries(eps as Record<string, { method: string; path: string; auth: string }>)) map[g]![k] = { method: e.method, path: e.path, auth: e.auth };
}
writeFileSync(
  out,
  `// AUTO-GENERATED by website/scripts/gen-endpoints.mts — do not edit.\n` +
    `import type { contracts as C } from './index';\n\n` +
    `export const endpoints = ${JSON.stringify(map, null, 2)} as unknown as typeof C;\n`,
);
console.info(`endpoints: ${Object.values(map).reduce((a, g) => a + Object.keys(g).length, 0)}`);
