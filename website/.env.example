# Website (React + Vite). Only VITE_* variables reach the browser — never put secrets here.
# The site always calls the API on its own origin (/api/v1); Caddy (infra/) or the Vite proxy forwards it.
# Dev/preview proxy target for /api and /sitemap.xml (the Spring Boot backend):
VITE_API_PROXY=http://localhost:8080
# Public runtime config (Google client id, feature flags, payment gateway) comes from GET /api/v1/config.
